---
import { type Lang, pick, asset } from '../i18n';
import { team } from '../data/team';
interface Props { lang: Lang; name: string }
const { lang, name } = Astro.props;
const t = pick(lang);
const initials = (n: string) => n.split(/\s+/).map(w => w[0]).join('').slice(0, 2).toUpperCase();
---
<section class="sec s-alt" id="team" data-sec data-name={name}>
  <span class="idx"></span>
  <h2 class="q" data-scroll>{t({ en: 'The team', it: 'Il team' })}</h2>
  <p class="lead">{t({ en: 'The Qubito students organising the hackathon.', it: "Gli studenti di Qubito che organizzano l'hackathon." })}</p>
  <div class="team">
    {team.map(m => (
      <div class="member">
        {m.photo
          ? <img class="avatar" src={asset(m.photo)} alt="" loading="lazy">
          : <div class="avatar" aria-hidden="true">{initials(m.name)}</div>}
        <strong>{m.name}</strong><small>{t(m.role)}</small>
      </div>
    ))}
  </div>
</section>
