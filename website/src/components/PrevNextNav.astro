---
/* Links to the previous and the next page of a series (articles, activities), in the same language. */

interface Link {
  href: string;
  title: string;
}

interface Props {
  older?: Link | undefined;
  newer?: Link | undefined;
  labels: { older: string; newer: string; nav: string };
}

const { older, newer, labels } = Astro.props;
const links = [
  older && { ...older, label: labels.older, side: 'older' },
  newer && { ...newer, label: labels.newer, side: 'newer' },
].filter((link) => !!link);
---

{links.length > 0 && (
  <nav class="page-nav" aria-label={labels.nav}>
    {links.map(({ href, title, label, side }) => (
      <a href={href} class:list={['page-nav-link', `is-${side}`]}>
        <span class="page-nav-label">{label}</span>
        <span class="page-nav-title">{title}</span>
      </a>
    ))}
  </nav>
)}

<style>
  .page-nav {
    display: grid;
    gap: 1rem;
    border-top: 1px solid color-mix(in oklab, var(--color-frost) 12%, transparent);
    padding-top: 2rem;
  }

  @media (min-width: 40rem) {
    .page-nav {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .is-newer {
      grid-column: 2;
      text-align: right;
    }
  }

  .page-nav-link {
    display: grid;
    gap: 0.4rem;
    text-decoration: none;
  }

  .page-nav-label {
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .page-nav-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.2;
    transition: color 200ms var(--ease-cryo);
  }

  .page-nav-link:hover .page-nav-title {
    color: var(--color-orchid);
  }
</style>
