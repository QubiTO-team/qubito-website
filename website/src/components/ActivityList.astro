---
/* Compact list of activities: date, place, title, result and summary, with the first photo. */
import { Picture } from 'astro:assets';
import { activityUrl, type Activity } from '../lib/content';
import { widthsUpTo } from '../lib/images';
import { formatDate, type Lang } from '../i18n/utils';

interface Props {
  activities: Activity[];
  lang: Lang;
}

const { activities, lang } = Astro.props;
---

<ul class="activity-list">
  {activities.map((activity) => {
    const { title, description, date, dateLabel, location, result, gallery } = activity.data;
    const photo = gallery[0];
    return (
      <li class="activity">
        {photo && (
          <Picture
            src={photo.src}
            alt={photo.alt}
            widths={widthsUpTo(photo.src, [240, 480])}
            sizes="(min-width: 40rem) 12rem, 100vw"
            formats={['avif', 'webp']}
            class="activity-photo"
          />
        )}
        <div class:list={['activity-body', { 'activity-body-wide': !photo }]}>
          <p class="activity-meta">
            <time datetime={date.toISOString().slice(0, 10)}>
              {dateLabel ?? formatDate(date, lang)}
            </time>
            {location && <span>{location}</span>}
          </p>
          <h3 class="activity-title">
            <a href={activityUrl(activity, lang)}>{title}</a>
          </h3>
          {result && <p class="activity-result">{result}</p>}
          <p class="activity-description">{description}</p>
        </div>
      </li>
    );
  })}
</ul>

<style>
  .activity-list {
    margin-top: 2.5rem;
    border-top: 1px solid color-mix(in oklab, var(--color-frost) 12%, transparent);
  }

  .activity {
    position: relative;
    display: grid;
    gap: 1.25rem 2rem;
    padding-block: 2rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-frost) 12%, transparent);
  }

  @media (min-width: 40rem) {
    .activity {
      grid-template-columns: 12rem 1fr;
    }

    .activity-body-wide {
      grid-column: 1 / -1;
    }
  }

  .activity-photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.125rem;
  }

  .activity-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .activity-meta > span {
    color: var(--color-frost-muted);
  }

  .activity-title {
    margin-top: 0.6rem;
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .activity-title a {
    text-decoration: none;
    transition: color 200ms var(--ease-cryo);
  }

  /* The whole row is clickable, while the link text stays the title only. */
  .activity-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .activity:hover .activity-title a {
    color: var(--color-orchid);
  }

  .activity-result {
    margin-top: 0.4rem;
    color: var(--color-orchid);
  }

  .activity-description {
    margin-top: 0.6rem;
    color: var(--color-frost-muted);
  }
</style>
