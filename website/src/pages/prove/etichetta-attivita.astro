---
// Temporary test page: two looks for the "In corso" / "In arrivo" label of the home page list.
// The second activity has made-up dates (from yesterday, for two months) to show both labels.
import ActivityList from '../../components/ActivityList.astro';
import ActivityStatus from '../../components/ActivityStatus.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getActivities } from '../../lib/content';

const day = 24 * 60 * 60 * 1000;
const sample = (await getActivities('it')).slice(0, 3).map((activity, index) =>
  index === 1
    ? {
        ...activity,
        data: {
          ...activity.data,
          date: new Date(Date.now() - day),
          endDate: new Date(Date.now() + 60 * day),
          dateLabel: 'Date finte per la prova',
        },
      }
    : activity,
);
---

<BaseLayout lang="it" title="Prova: etichetta delle attività" noindex>
  <div class="shell prova">
    <h1>Etichetta "In corso" / "In arrivo"</h1>
    <p>
      Come in "Cosa facciamo" della home. La seconda attività ha date finte, per vedere anche "In
      corso"; le attività finite non hanno etichetta.
    </p>

    <h2>Variante A: pillola</h2>
    <ActivityList activities={sample} lang="it" label="pill" />

    <h2>Variante B: punto</h2>
    <ActivityList activities={sample} lang="it" label="dot" />
  </div>
  <ActivityStatus />
</BaseLayout>

<style>
  .prova {
    padding-block: 4rem;
  }

  .prova h1 {
    font-size: var(--text-3xl);
  }

  .prova p {
    max-width: 40rem;
    margin-top: 1rem;
    color: var(--color-frost-muted);
  }

  .prova h2 {
    margin-top: 4rem;
    color: var(--color-gold);
    font-size: var(--text-2xl);
  }
</style>
