---
/*
 * About us: presentation, the team over the years (a group photo per year) and how the team
 * works; the invitation to join only while applications are open. There is no list of members on
 * purpose.
 */
import '../styles/article.css';
import { getImage } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import PageHeader from '../components/PageHeader.astro';
import TeamYears from '../components/TeamYears.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { applicationsOpen } from '../lib/applications';
import { localizePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const open = await applicationsOpen();

const page = await getEntry('pages', `${lang}/team`);
if (!page) throw new Error(`Missing "team" page for "${lang}"`);
const { title, description, lead } = page.data;
const years = page.data.years.toSorted((a, b) => b.year - a.year);
const { Content } = await render(page);
// The newest photo is the picture shown when the page is shared.
const image = years[0];
const socialImage =
  image &&
  (await getImage({ src: image.src, width: Math.min(1200, image.src.width), format: 'jpg' }));
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  image={socialImage?.src}
  imageAlt={image?.alt}
>
  <div class="shell page">
    <PageHeader title={title} lead={lead} />

    {years.length > 0 && <TeamYears title={t('team.years')} years={years} />}

    <div class="prose page-body">
      <Content />
    </div>

    {open && (
      <section class="page-join" aria-labelledby="join-title">
        <h2 id="join-title" class="page-join-title">
          {t('team.joinTitle')}
        </h2>
        <a href={localizePath('/join-us/', lang)} class="btn btn-primary">
          {t('nav.joinUs')}
        </a>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(2.5rem, 7vw, 5rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .page-body {
    max-width: 44rem;
    margin-top: 3.5rem;
  }

  .page-join {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2.5rem;
    max-width: 44rem;
    margin-top: 4.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid color-mix(in oklab, var(--color-frost) 12%, transparent);
  }

  .page-join-title {
    font-size: var(--text-xl);
  }
</style>
