---
/*
 * All the activities in one language on a timeline: first the ongoing ones and the upcoming
 * ones, each section only when it has something (decided when the site is built), then the
 * others grouped by year, newest first.
 */
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { activityStatus, getActivities, type Activity, type ActivityStatus } from '../lib/content';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const activities = await getActivities(lang);
const withStatus = (status: ActivityStatus) =>
  activities.filter((activity) => activityStatus(activity) === status);
const years = new Map<number, Activity[]>();
for (const activity of withStatus('past')) {
  const year = activity.data.date.getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), activity]);
}
const groups = [
  // Ongoing and upcoming: soonest first, with the title in orchid instead of gold.
  {
    id: 'ongoing',
    title: t('activities.ongoing'),
    activities: withStatus('ongoing').reverse(),
    highlighted: true,
  },
  {
    id: 'upcoming',
    title: t('activities.upcoming'),
    activities: withStatus('upcoming').reverse(),
    highlighted: true,
  },
  ...[...years].map(([year, activities]) => ({
    id: `year-${year}`,
    title: String(year),
    activities,
    highlighted: false,
  })),
].filter((group) => group.activities.length > 0);
---

<BaseLayout lang={lang} title={t('nav.activities')} description={t('activities.description')}>
  <div class="shell activities">
    <header>
      <h1 class="activities-title">{t('nav.activities')}</h1>
      <p class="activities-intro">{t('activities.intro')}</p>
    </header>

    {groups.map((group) => (
      <section class="group" aria-labelledby={group.id}>
        <h2 id={group.id} class:list={['group-title', { 'is-highlighted': group.highlighted }]}>
          {group.title}
        </h2>
        <Timeline activities={group.activities} lang={lang} />
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .activities {
    padding-top: clamp(2.5rem, 7vw, 5rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .activities-title {
    font-size: var(--text-4xl);
    line-height: var(--text-4xl--line-height);
  }

  .activities-intro {
    max-width: 46rem;
    margin-top: 1.5rem;
    color: var(--color-frost-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .group {
    display: grid;
    gap: 0.5rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .group-title {
    color: var(--color-gold);
    font-size: var(--text-2xl);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .group-title.is-highlighted {
    color: var(--color-orchid);
  }

  /* Large screens: the year on the left, its activities on the right. */
  @media (min-width: 64rem) {
    .group {
      grid-template-columns: 10rem minmax(0, 60rem);
      gap: 3rem;
      align-items: start;
    }

    .group-title {
      position: sticky;
      top: 6.5rem;
      padding-top: 1.5rem;
    }
  }
</style>
