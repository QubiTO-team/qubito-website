---
/*
 * All the activities in one language on a timeline: first the ongoing ones and the upcoming
 * ones, then the others grouped by year, newest first. Sections without activities are hidden.
 * The build decides where each activity goes; ActivityStatus.astro moves it in the browser when
 * the site was built before the activity started or ended, so every section is always there.
 */
import ActivityStatus from '../components/ActivityStatus.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  activityStatus,
  getActivities,
  type Activity,
  type ActivityStatus as Status,
} from '../lib/content';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const activities = await getActivities(lang);
const withStatus = (status: Status) =>
  activities.filter((activity) => activityStatus(activity) === status);
const yearOf = (activity: Activity) => activity.data.date.getUTCFullYear();
// Newest first, like the activities.
const years = [...new Set(activities.map(yearOf))];
const groups = [
  // Ongoing and upcoming: soonest first, with the title in orchid instead of gold.
  {
    key: 'ongoing',
    id: 'ongoing',
    title: t('activities.ongoing'),
    activities: withStatus('ongoing').reverse(),
    highlighted: true,
  },
  {
    key: 'upcoming',
    id: 'upcoming',
    title: t('activities.upcoming'),
    activities: withStatus('upcoming').reverse(),
    highlighted: true,
  },
  ...years.map((year) => ({
    key: String(year),
    id: `year-${year}`,
    title: String(year),
    activities: withStatus('past').filter((activity) => yearOf(activity) === year),
    highlighted: false,
  })),
];
---

<BaseLayout lang={lang} title={t('nav.activities')} description={t('activities.description')}>
  <div class="shell activities">
    <header>
      <h1 class="activities-title">{t('nav.activities')}</h1>
      <p class="activities-intro">{t('activities.intro')}</p>
    </header>

    {groups.map((group) => (
      <section
        class="group"
        aria-labelledby={group.id}
        data-section={group.key}
        hidden={group.activities.length === 0}
      >
        <h2 id={group.id} class:list={['group-title', { 'is-highlighted': group.highlighted }]}>
          {group.title}
        </h2>
        <Timeline activities={group.activities} lang={lang} />
      </section>
    ))}
  </div>
  <ActivityStatus />
</BaseLayout>

<style>
  .activities {
    padding-top: clamp(2.5rem, 7vw, 5rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .activities-title {
    font-size: var(--text-4xl);
    line-height: var(--text-4xl--line-height);
  }

  .activities-intro {
    max-width: 46rem;
    margin-top: 1.5rem;
    color: var(--color-frost-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .group {
    display: grid;
    gap: 0.5rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .group-title {
    color: var(--color-gold);
    font-size: var(--text-2xl);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .group-title.is-highlighted {
    color: var(--color-orchid);
  }

  /* Large screens: the year on the left, its activities on the right. */
  @media (min-width: 64rem) {
    .group {
      grid-template-columns: 10rem minmax(0, 60rem);
      gap: 3rem;
      align-items: start;
    }

    .group-title {
      position: sticky;
      top: 6.5rem;
      padding-top: 1.5rem;
    }
  }
</style>
